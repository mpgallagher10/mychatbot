# ---------------------------------------------------------------------------
# Turn Inspection Processing — environment configuration
# Copy to .env for local dev; set these as Railway variables in production.
# ---------------------------------------------------------------------------

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app
LOG_LEVEL=INFO

# --- Database (Railway injects DATABASE_URL for the Postgres plugin) ---
# Leave unset locally to use a SQLite file (dev.sqlite3).
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Storage (point at a mounted Railway volume in production) ---
MEDIA_STORAGE_ROOT=./storage

# --- Webhook auth (shared secret the contractor form / SF Flow must send) ---
WEBHOOK_SHARED_SECRET=change-me

# --- Image downsampling ---
IMAGE_LONG_EDGE_PX=1568
IMAGE_JPEG_QUALITY=80

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=3.0
JOB_MAX_ATTEMPTS=3

# --- Dropbox (prefer refresh-token app auth) ---
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# ...or a short-lived token for quick local testing:
DROPBOX_ACCESS_TOKEN=

# --- Salesforce ---
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login   # use "test" for a sandbox

# --- Anthropic (used by the Pass 1/2/3 eval increments) ---
ANTHROPIC_API_KEY=
